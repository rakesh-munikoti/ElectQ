{
  "name": "electiq",
  "version": "2.0.0",
  "description": "ElectIQ — Interactive Election Guide. A zero-dependency, multilingual, gamified civic education web app powered by Firebase and Google AI.",
  "main": "public/js/app.js",
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --coverage --ci --reporters=default --reporters=jest-junit",
    "lint": "eslint public/js/**/*.js",
    "audit": "npm audit --audit-level=high",
    "pretest": "echo 'Running ElectIQ test suite...'",
    "deploy": "firebase deploy --only hosting"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "keywords": [
    "election",
    "civic",
    "voter",
    "guide",
    "multilingual",
    "firebase",
    "accessibility",
    "gamification"
  ],
  "author": "Rakesh Munikoti",
  "license": "MIT",
  "homepage": "https://electiq-rakesh-ch2.web.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/rakesh-munikoti/ElectQ"
  }
}
